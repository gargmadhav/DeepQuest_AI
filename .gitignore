# ==========================================
# Hermes Autonomous Agent - Git Ignore Rules
# ==========================================

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & API Keys
.env
.env.local
.env.*.local

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Database Files
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite3-journal
test_memory.db

# Node.js & React Frontend
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.nx/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Generated Artifacts & Temp Reports
reports/*.md
!reports/.gitkeep

# IDEs & System Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Log Files
*.log
